# Copy this file to .env and fill in your values:  cp .env.example .env
# Values come from your deployment's details page in the Foundry portal (https://ai.azure.com).

# --- Required ---------------------------------------------------------------

# Foundry resource endpoint. The resource root or the portal's ".../models" URL both work.
AZURE_ENDPOINT=https://<your-resource-name>.services.ai.azure.com

# The name you gave the Microsoft-Decision-1 deployment (not the model name).
DEPLOYMENT_NAME=<your-deployment-name>

# API key from the deployment details page.
# Leave empty to use Microsoft Entra ID instead (run `az login` first).
AZURE_API_KEY=<your-api-key>

# --- Optional (API server only) ---------------------------------------------

# Routing guide loaded at startup. Restart the server after editing it.
# ROUTING_GUIDE=context/routing_guide.md

# Seconds between keep-warm pings that stop Azure closing the idle connection. 0 disables.
# KEEPALIVE_SECONDS=60
